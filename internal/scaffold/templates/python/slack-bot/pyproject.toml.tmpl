[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "{{.Name}}"
version = "0.1.0"
description = "Slack bot agent worker for Norns"
requires-python = ">=3.10"
dependencies = [
    "norns-sdk",
    "anthropic>=0.40",
    "httpx>=0.27",
]

[project.scripts]
{{.Name}}-worker = "{{.PackageName}}.worker:main"
{{.Name}}-client = "{{.PackageName}}.client:main"
