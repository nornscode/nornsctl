[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "{{.Name}}"
version = "0.1.0"
description = "Agent worker for Norns"
requires-python = ">=3.10"
dependencies = [
    "norns-sdk",
    "anthropic>=0.40",
]

[project.scripts]
{{.Name}}-worker = "{{.PackageName}}.worker:main"
{{.Name}}-client = "{{.PackageName}}.client:main"

[tool.uv]
# litellm 1.96.1 (via norns-sdk) shipped cp310-only wheels; keep resolution
# off it until a fixed release. Safe to remove once norns-sdk excludes it.
constraint-dependencies = ["litellm!=1.96.1"]
